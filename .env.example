# Server code runs in workerd and reads vars from .dev.vars (copy .dev.vars.example).
# .env* covers the Vite client and CLI scripts (db:migrate, tests, db:seed-admin).
# Local Postgres (Docker). Used by db:migrate, tests, and the dev server.
DATABASE_URL=postgresql://destr:destr@localhost:5432/destr
# Clerk publishable + secret keys from the Clerk dashboard (API keys page).
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk webhook signing secret (Webhooks page, endpoint /api/webhooks/clerk).
# The app rejects deliveries with a bad signature (401) before any DB write.
CLERK_WEBHOOK_SIGNING_SECRET=
# Password policy is configured in the Clerk dashboard (password rules):
# more than 8 characters, at least one uppercase, one lowercase, one special.
RESEND_API_KEY=
EMAIL_FROM=Destr <billing@example.com>
APP_URL=http://localhost:3000
JOB_SECRET=
WEBHOOK_SIGNING_SECRET=
# First admin: create the account in Clerk (sign up once), then promote it:
#   pnpm db:seed-admin <email>
# Demoting that account from the staff page is refused; rerun the command to restore it.
